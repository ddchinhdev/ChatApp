MYSQL_PASSWORD=replace_with_a_strong_database_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_strong_root_password
JWT_SECRET=replace_with_at_least_48_random_characters_for_hs384_signing
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:8088

# Optional and disabled by default. Never use these demo credentials in production.
DEMO_SEED_ENABLED=false
DEMO_USER_PASSWORD=replace_with_demo_user_password
DEMO_ADMIN_PASSWORD=replace_with_demo_admin_password
